# PowerWatch Configuration
# Copy this file to .env and fill in real values

# Database
DATABASE_URL=sqlite:///./powerwatch.db

# Secret key for sessions
SECRET_KEY=dev-secret-key-change-in-production

# Facebook Monitoring
# Get this from Meta for Developers: https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token-here

# How often to poll Facebook sources (minutes)
FACEBOOK_POLL_INTERVAL_MINUTES=1

# JSON array of Facebook sources to monitor
# Example: [{"name": "NORECO II", "page_id": "NORECO2Official", "enabled": true}, {"name": "NGCP", "page_id": "NGCPph", "enabled": true}]
FACEBOOK_SOURCES=[]

# Enable or disable Facebook monitoring entirely
FACEBOOK_ENABLED=true

# Application
DEBUG=true
